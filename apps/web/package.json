    "@svgr/webpack": "^7.0.0",
    "@tanstack/react-query": "^5.72.2",
    "@zodios/core": "^10.9.6",
    "autoprefixer": "10.4.14",
    "axios": "^1.4.0",
    "classnames": "^2.3.2",
    "next": "13.3.0",
    "nprogress": "^0.2.0",
    "orval": "^7.8.0",
    "postcss": "8.4.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.55.0",
    "react-hot-toast": "^2.5.2",
